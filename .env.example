# 환경변수 목록 (값은 비워둠). 실제 값은 .env/.env.{local,dev,prod} 에 작성 — .env/ 는 git 제외
# Spring은 아래 이름을 그대로 spring.* 프로퍼티로 인식함 (예: SPRING_DATASOURCE_URL → spring.datasource.url)

SPRING_PROFILES_ACTIVE=

# DB (PostgreSQL + PostGIS). local은 compose.yaml이 자동 연결하므로 비워둬도 됨
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
